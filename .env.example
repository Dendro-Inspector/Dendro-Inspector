# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Every unit, contract and integration test runs on the fake provider and needs none of this.

# --- Provider selection (logical role -> adapter) ---
# Adapters: fake | openai | anthropic
DENDRO_PRIMARY_PROVIDER=fake
DENDRO_ARBITER_PROVIDER=fake

# --- Model names (never hardcoded in business logic) ---
DENDRO_PRIMARY_MODEL=
DENDRO_ARBITER_MODEL=

# --- Credentials (read from the environment only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Fake provider ---
# Scenario script used when the fake adapter is selected.
DENDRO_FAKE_SCENARIO=primary-pass

# --- Prompt bundle (opaque artifacts, fail-closed compatibility manifest) ---
# A custom domain path requires a matching non-default manifest path.
DENDRO_DOMAIN_PROMPT_PATH=prompts/domain/system-prompt.md
DENDRO_PROMPT_MANIFEST_PATH=prompts/versions.yaml

# --- Presentation register (deployment choice, never a scientific one) ---
# standard (default, safe for demos and workplaces) | direct (author's register)
DENDRO_TONE_PROFILE=standard

# --- Knowledge ---
DENDRO_KNOWLEDGE_ROOT=knowledge
DENDRO_REGION_PACK=eastern-europe

# --- Observability ---
DENDRO_LOG_LEVEL=INFO
DENDRO_TRACE_DIR=

