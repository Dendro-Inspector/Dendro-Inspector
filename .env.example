# Copy to .env and fill in. .env is git-ignored — never commit real keys.
# Every unit, contract and integration test runs on the fake provider and needs none of this.

# This file is read at startup if it exists. A variable already exported in the environment
# always wins over the value here.

# --- Provider selection (logical role -> adapter) ---
# Adapters: fake | openai | anthropic | anthropic-sdk | gemini | nvidia | openrouter | ollama
# Every non-fake adapter needs a model that accepts images: each node call carries one.
DENDRO_PRIMARY_PROVIDER=fake
DENDRO_REVIEWER_PROVIDER=fake
DENDRO_ARBITER_PROVIDER=fake

# --- Model names (never hardcoded in business logic) ---
DENDRO_PRIMARY_MODEL=
DENDRO_REVIEWER_MODEL=
DENDRO_ARBITER_MODEL=

# --- Credentials (read from the environment only) ---
# Each adapter reads its own variable; the role does not decide which.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# Fail closed for private photographs. Set to allow only with current-session owner approval.
OPENROUTER_DATA_COLLECTION=deny

# --- Direct SDK image transport ---
# files (default): upload prepared bytes once per provider/credential scope in a run,
# reuse file IDs, then delete at teardown. Each upload also expires after one hour.
# Requires current SDKs with native Files API and expiry support. OpenAI uses Responses
# with store=false; Anthropic keeps native Messages. File references save upload bytes;
# token savings depend on prompt caching. Install the images extra to strip metadata.
# inline: retain base64 image blocks; OpenAI uses Chat Completions for compatible hosts.
# The anthropic bridge adapter and all other providers keep their existing transport.
OPENAI_IMAGE_TRANSPORT=files
ANTHROPIC_IMAGE_TRANSPORT=files

# --- Gemini: Generative Language API vs Vertex / Agent Platform ---
# Default (unset) is the Generative Language API, authenticated with GEMINI_API_KEY above.
# For Vertex — the route a Cloud billing account and its credits apply to — point the
# endpoint at the publisher path and supply a bearer token instead of the API key. When
# GOOGLE_ACCESS_TOKEN is set it wins over GEMINI_API_KEY.
#   GEMINI_ENDPOINT=https://aiplatform.googleapis.com/v1/projects/<PROJECT>/locations/global/publishers/google
# The token expires in about an hour, so refresh it per run rather than committing to a
# shell: gcloud auth application-default print-access-token
GEMINI_ENDPOINT=
GOOGLE_ACCESS_TOKEN=
# Thinking budget on models that support it: LOW | MEDIUM | HIGH. Unset leaves the model's
# own default. An unknown value is rejected by the API, not by this project.
GEMINI_THINKING_LEVEL=
# Seconds before one Gemini call is abandoned. A phone photograph needs far more than the
# 120s that suits a text prompt.
GEMINI_TIMEOUT_SECONDS=

# --- OpenAI-compatible hosts ---
# Point either at any OpenAI-compatible server — a self-hosted NIM, vLLM — to reuse the
# adapter. Only needed if it is not the vendor's hosted default.
NVIDIA_BASE_URL=
OPENROUTER_BASE_URL=

# --- Structured-output repair ---
# How many times a malformed response is returned to the model with its validation error.
# Smaller models usually need more than the default of 1.
DENDRO_STRUCTURED_RETRIES=1

# --- Ollama (local, no credential) ---
# Requires `ollama serve` running and a vision-capable model pulled locally
# (`ollama pull gemma4:e4b`) — a text-only model ignores images instead of failing.
# Base URL Ollama listens on; only needed if it is not the default.
OLLAMA_HOST=

# --- Fake provider ---
# Scenario script used when the fake adapter is selected.
DENDRO_FAKE_SCENARIO=primary-pass

# --- Prompt bundle (opaque artifacts, fail-closed compatibility manifest) ---
# A custom domain path requires a matching non-default manifest path.
DENDRO_DOMAIN_PROMPT_PATH=prompts/domain/system-prompt.md
DENDRO_PROMPT_MANIFEST_PATH=prompts/versions.yaml

# --- Presentation register (deployment choice, never a scientific one) ---
# standard (default, safe for demos and workplaces) | direct (author's register)
DENDRO_TONE_PROFILE=standard

# --- Knowledge ---
DENDRO_KNOWLEDGE_ROOT=knowledge
DENDRO_REGION_PACK=eastern-europe
# Let a subject held back only by the knowledge-coverage gate reach the candidate generator,
# so a taxon with no card can be reported as an open-world candidate. Never selected as a
# verdict. Off by default: the coverage gap then ends the run before any further model call.
DENDRO_OPEN_WORLD_DISCOVERY=false
# Call the arbiter on every case that reaches the escalation gate, abstentions included. It
# still only proposes findings; code decides. Costs one more model call per inspection.
DENDRO_ARBITER_EVERY_DECISION=false
# Longest edge (pixels) of each photograph sent to models; default 1568. A large value such as
# 8192 sends the full resolution, still rotated upright with metadata stripped. "original" sends
# the file untouched: no rotation from the EXIF orientation tag, GPS and device data included.
# DENDRO_IMAGE_MAX_EDGE_PX=1568
# Local YAML of saved reference records, checked against open-world candidates. Saved records
# are operator-supplied: they can dispute a candidate but never mark it externally_verified.
# Empty means nothing is checked; candidates then report reference status `unavailable`.
DENDRO_REFERENCE_RECORDS=

# --- Observability ---
DENDRO_LOG_LEVEL=INFO
DENDRO_TRACE_DIR=
