# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local config — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Evaluation baselines are tracked artifacts - they are the regression guard.
!evals/baselines/**

# Local run output
traces/
runs/
*.trace.json
eval-report-*.json

# Private evaluation material (see docs/dataset-policy.md)
evals/golden/**
!evals/golden/README.md

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# User-supplied photographs are not redistributable — keep them local
examples/*.jpg
examples/*.jpeg
examples/*.png
examples/*.webp

