# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets and local config — never commit these
.env
.env.*
!.env.example
*.pem
*.key

# Evaluation baselines are tracked artifacts - they are the regression guard.
!evals/baselines/**

# Working notes. Never committed, and never swept into an sdist by a local build.
/log.md

# Local run output
traces/
runs/
*.trace.json
eval-report-*.json

# Agent-as-provider bridge state. Holds the decoded photographs of every call it served,
# plus prompts and cached model answers. See docs/agent-as-provider.md.
.bridge/

# Private evaluation material (see docs/dataset-policy.md)
evals/golden/**
!evals/golden/README.md
evals/100 top/**

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# User-supplied photographs are not redistributable — keep them local
examples/*.jpg
examples/*.jpeg
examples/*.png
examples/*.webp
